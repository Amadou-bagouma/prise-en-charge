//=========================
// APPLICATION JHIPSTER
// CNSS - PRISE EN CHARGE MEDICALE
// Compatible JHipster 8.11.0
// =========================================================

application {
  config {
    baseName peccnss
    applicationType monolith
    authenticationType jwt
    databaseType sql
    devDatabaseType postgresql
    prodDatabaseType postgresql
    buildTool maven
    clientFramework angular
  }

  entities *
}


// =========================================================
// ORGANISATION
// =========================================================

entity Gestion {
  nom String required
  type TypeGestion required
}

enum TypeGestion {
  AS
  OA
}


entity Region {
  nom String required unique
}


entity Direction {
  code String required unique
  nom String required
}


entity Agent {
  matricule String required unique
  nom String required
  prenom String required
  dateNaissance LocalDate
  telephone String
  fonction String
}


// =========================================================
// AYANT DROIT
// =========================================================

entity AyantDroit {
  nom String required
  prenom String required
  dateNaissance LocalDate
  lien LienParente required
}


enum LienParente {
  CONJOINT
  ENFANT
  AUTRE
}


// =========================================================
// TYPES DE SOINS
// =========================================================

entity TypeSoin {
  libelle String required unique
  description String
  actif Boolean required
}


// =========================================================
// ETABLISSEMENT DE SANTE
// =========================================================

entity EtablissementSante {
  code String required unique
  nom String required
  adresse String
  telephone String
  actif Boolean required
}


// =========================================================
// DEMANDE DE PRISE EN CHARGE
// =========================================================

entity DemandePriseEnCharge {
  reference String required unique
  dateCreation Instant required
  dateModification Instant
  typeBeneficiaire TypeBeneficiaire required
  description String
  statut StatutDemande required
  priorite PrioriteDemande required
  dateAssignation Instant
  dateEcheance Instant
  motifRejet String
  observation String
}


enum TypeBeneficiaire {
  AGENT
  AYANT_DROIT
}


enum StatutDemande {
  NOUVELLE
  EN_ATTENTE_PIECES
  A_TRAITER
  EN_COURS_TRAITEMENT
  EN_ATTENTE_AVIS_MEDICAL
  EN_ATTENTE_DECISION
  VALIDEE
  REJETEE
  ANNULEE
  CLOTUREE
}


enum PrioriteDemande {
  NORMALE
  IMPORTANTE
  URGENTE
}


// =========================================================
// PIECES JUSTIFICATIVES
// =========================================================

entity PieceJustificative {
  nomFichier String required
  cheminFichier String required
  dateAjout Instant required
}


// =========================================================
// TACHES
// =========================================================
// Une tâche représente une action à effectuer par un utilisateur.
// Elle constitue l'élément principal de la boîte de réception.
// =========================================================

entity Tache {
  titre String required
  description String
  dateCreation Instant required
  dateAssignation Instant
  dateEcheance Instant
  dateTerminaison Instant
  statut StatutTache required
  priorite PrioriteTache required
  lu Boolean required
  commentaire String
}


enum StatutTache {
  A_FAIRE
  EN_COURS
  EN_ATTENTE
  TERMINEE
  ANNULEE
}


enum PrioriteTache {
  NORMALE
  IMPORTANTE
  URGENTE
}


// =========================================================
// BOITE DE RECEPTION
// =========================================================
// Une boîte de réception appartient à un utilisateur JHipster.
// Elle regroupe les tâches et informations qui lui sont destinées.
// =========================================================

entity BoiteReception {
  dateCreation Instant required
  dateDerniereLecture Instant
  nombreNonLus Integer required
  actif Boolean required
}


// =========================================================
// NOTIFICATIONS
// =========================================================

entity Notification {
  titre String required
  message String required
  dateCreation Instant required
  dateLecture Instant
  lu Boolean required
  type TypeNotification required
}


enum TypeNotification {
  NOUVELLE_TACHE
  NOUVELLE_DEMANDE
  DEMANDE_ASSIGNEE
  DEMANDE_MODIFIEE
  ECHEANCE_PROCHE
  DEMANDE_VALIDEE
  DEMANDE_REJETEE
  INFORMATION
}


// =========================================================
// HISTORIQUE DES ACTIONS
// =========================================================
// ATTENTION :
// Il ne s'agit PAS d'un historique des validations.
// Cette entité permet uniquement de tracer les actions
// effectuées sur une demande.
// =========================================================

entity HistoriqueAction {
  action String required
  description String
  dateAction Instant required
}


// =========================================================
// RELATIONS ORGANISATION
// =========================================================

relationship ManyToOne {

  Direction{region(nom)} to Region

  Agent{direction(nom)} to Direction

  Agent{gestion(nom)} to Gestion

  AyantDroit{agent(matricule)} to Agent

  Agent{user(login)} to User with builtInEntity
}


// =========================================================
// RELATIONS DEMANDE
// =========================================================

relationship ManyToOne {

  DemandePriseEnCharge{agent(matricule)} to Agent

  DemandePriseEnCharge{ayantDroit(nom)} to AyantDroit

  DemandePriseEnCharge{typeSoin(libelle)} to TypeSoin

  DemandePriseEnCharge{etablissementSante(nom)} to EtablissementSante
}


// =========================================================
// CREATEUR ET RESPONSABLE DE LA DEMANDE
// =========================================================

relationship ManyToOne {

  DemandePriseEnCharge{gestionnaireCreateur(login) required} to User with builtInEntity

  DemandePriseEnCharge{assigneA(login)} to User with builtInEntity
}


// =========================================================
// PIECES JUSTIFICATIVES
// =========================================================

relationship ManyToOne {

  PieceJustificative{demande(reference) required} to DemandePriseEnCharge
}


// =========================================================
// TACHES
// =========================================================

relationship ManyToOne {

  Tache{demande(reference) required} to DemandePriseEnCharge

  Tache{utilisateur(login) required} to User with builtInEntity

  Tache{boiteReception} to BoiteReception
}


// =========================================================
// BOITE DE RECEPTION
// =========================================================

relationship OneToOne {

  BoiteReception{utilisateur(login) required} to User with builtInEntity
}


// =========================================================
// NOTIFICATIONS
// =========================================================

relationship ManyToOne {

  Notification{utilisateur(login) required} to User with builtInEntity

  Notification{demande(reference)} to DemandePriseEnCharge

  Notification{tache(titre)} to Tache
}


// =========================================================
// HISTORIQUE DES ACTIONS
// =========================================================

relationship ManyToOne {

  HistoriqueAction{demande(reference) required} to DemandePriseEnCharge

  HistoriqueAction{utilisateur(login) required} to User with builtInEntity
}


// =========================================================
// PAGINATION
// =========================================================

paginate Region, Direction, Gestion, Agent, AyantDroit, TypeSoin, EtablissementSante, DemandePriseEnCharge, PieceJustificative, Tache, BoiteReception, Notification, HistoriqueAction with pagination


// =========================================================
// SERVICES
// =========================================================

service Region, Direction, Gestion, Agent, AyantDroit, TypeSoin, EtablissementSante, DemandePriseEnCharge, PieceJustificative, Tache, BoiteReception, Notification, HistoriqueAction with serviceImpl


// =========================================================
// DTO MAPSTRUCT
// =========================================================

dto Region, Direction, Gestion, Agent, AyantDroit, TypeSoin, EtablissementSante, DemandePriseEnCharge, PieceJustificative, Tache, BoiteReception, Notification, HistoriqueAction with mapstruct


// =========================================================
// FILTRES
// =========================================================

filter Region, Direction, Agent, AyantDroit, EtablissementSante, DemandePriseEnCharge, Tache, Notification, HistoriqueAction

