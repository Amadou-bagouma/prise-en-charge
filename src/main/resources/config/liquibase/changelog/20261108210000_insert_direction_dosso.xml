<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Ajoute la direction regionale de Dosso (code 519) dans la region de Dosso.

        Id pris dans le sequence_generator, comme ceux attribues par l'application. La region est
        retrouvee par son nom ; ignoree si le code existe deja.
    -->
    <changeSet id="20261108210000-1" author="manual">
        <sql>
            INSERT INTO direction (id, code, nom, region_id, created_by, created_date)
            SELECT nextval('sequence_generator'), '519', 'DIRECTION REGIONALE DOSSO', r.id, 'system', now()
            FROM region r
            WHERE upper(trim(r.nom)) = 'DOSSO'
            ON CONFLICT DO NOTHING
        </sql>
    </changeSet>
</databaseChangeLog>
