<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Adds an optional signature image to jhi_user, set by an admin for DRH/infirmerie
        validators so it can be printed on the demande's PDF report.
    -->
    <changeSet id="20260916150000-1" author="manual">
        <addColumn tableName="jhi_user">
            <column name="signature" type="${blobType}"/>
            <column name="signature_content_type" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <!--
        ${blobType} maps to PostgreSQL's oid (large-object reference), but a plain byte[]
        field without @Lob is written by Hibernate as bytea. Correct the column type so it
        actually matches what gets persisted.
    -->
    <changeSet id="20260916150000-2" author="manual">
        <dropColumn tableName="jhi_user" columnName="signature"/>
        <addColumn tableName="jhi_user">
            <column name="signature" type="bytea"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
