<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Dedicated, never-resetting sequence used to build DemandePriseEnCharge.reference
        server-side (date prefix + 7-digit sequence). Kept separate from the shared
        JHipster "sequence_generator" (which allocates in batches of 50 across every
        entity) so the counter increments by exactly 1 per demande, with no gaps.
    -->
    <changeSet id="20260915140000-1" author="manual">
        <createSequence sequenceName="demande_prise_en_charge_reference_seq" startValue="1" incrementBy="1"/>
    </changeSet>
</databaseChangeLog>
