<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Drops Agent.user: a JHipster-scaffolded link to a jhi_user account that was never
        read anywhere in the app (Agent is linked to DemandePriseEnCharge/AyantDroit
        directly, not through a user account).
    -->
    <changeSet id="20260916170000-1" author="manual">
        <dropForeignKeyConstraint baseTableName="agent" constraintName="fk_agent__user_id"/>
        <dropColumn tableName="agent" columnName="user_id"/>
    </changeSet>
</databaseChangeLog>
